{
  "name": "seiyuu-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run validate:content && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "audit:sources": "node --experimental-strip-types scripts/audit-sources.ts",
    "editorial:status": "node --experimental-strip-types scripts/editorial-status.ts",
    "editorial:gate": "node --experimental-strip-types scripts/editorial-status.ts --gate",
    "studio": "node --experimental-strip-types scripts/studio.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:http": "node scripts/verify-http.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "^0.35.4",
    "typescript": "5.9.3"
  }
}
